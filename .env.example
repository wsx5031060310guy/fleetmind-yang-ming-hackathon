# FleetMind local/event environment template.
# Copy to .env locally if useful. Never commit filled .env files.

AWS_REGION=ap-northeast-1

# Day1 Bedrock model or inference profile id after scripts/bedrock-models.sh.
FLEETMIND_BEDROCK_PROVIDER=Anthropic
FLEETMIND_BEDROCK_MODEL_ID=<model-id-or-inference-profile-id>

# Day1/Day3 data cleanup targets.
FLEETMIND_DATA_BUCKET=<event-s3-bucket>
FLEETMIND_DDB_TABLE=<event-dynamodb-table>
FLEETMIND_LOCAL_SNAPSHOT_DIR=work/local-snapshots

# Live/local demo verification.
BASE_URL=http://localhost:8080

# Optional probe resource prefix; leave blank for timestamp default.
FLEETMIND_PROBE_PREFIX=

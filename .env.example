# FleetMind local/event environment template.
# Copy to .env locally if useful. Never commit filled .env files.

# Deployed region is us-east-1 (workshop account). Bedrock/SNS live here;
# a mismatched region makes cross-region SNS publish fail silently.
AWS_REGION=us-east-1

# Day1 Bedrock model or inference profile id after scripts/bedrock-models.sh.
FLEETMIND_BEDROCK_PROVIDER=Anthropic
FLEETMIND_BEDROCK_MODEL_ID=REPLACE_WITH_MODEL_ID_OR_INFERENCE_PROFILE_ID

# Alert channels. SNS topic is already created; set the ARN to enable Email/SMS
# push from POST /api/alerts/notify. Optional generic webhook fans alerts out to
# any HTTPS endpoint, signed with HMAC-SHA256 over the body.
FLEETMIND_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:516665228894:fleetmind-alerts
FLEETMIND_WEBHOOK_URL=
FLEETMIND_WEBHOOK_SECRET=

# Day1/Day3 data cleanup targets.
FLEETMIND_DATA_BUCKET=REPLACE_WITH_EVENT_S3_BUCKET
FLEETMIND_DDB_TABLE=REPLACE_WITH_EVENT_DYNAMODB_TABLE
FLEETMIND_LOCAL_SNAPSHOT_DIR=work/local-snapshots

# Live/local demo verification.
BASE_URL=http://localhost:8080

# Optional probe resource prefix; leave blank for timestamp default.
FLEETMIND_PROBE_PREFIX=

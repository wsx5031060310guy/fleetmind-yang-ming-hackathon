# Without this file Vercel CLI falls back to .gitignore, which excludes public/ —
# and public/ is exactly what has to ship. It is generated by `npm run build` from
# apps/api/src/main/resources/static/, which lives outside this deploy root, so it
# cannot be regenerated on Vercel's builder. Build locally, upload the result.
node_modules
.env
.env.*
.vercel
test/golden
test/capture-golden.sh
SPEC.md

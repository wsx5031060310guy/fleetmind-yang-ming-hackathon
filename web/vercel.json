{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/verify-public.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  }
}
